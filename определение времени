def chas(x):
    if x > 12:
        x = x-12
    if x == 1:
        return 'час'
    elif x > 1 and x <5:
        return 'часа'
    else:
        return 'часов'
def minut(x):
    if x%10 == 0 and x != 0 or x >=10 and x<=20:
        return 'минут'
    elif x == 0:
        return 'ровно' 
    else:
        if x%10 == 1:
            return 'минута'
        elif x%10 >1 and x%10<5:
            return 'минуты'
        else:
            return 'минут'
        
def vremyadnya(x):
    if x >= 0 and x < 6:
        return 'ночи'
    elif x <= 6 and x < 12:
        return 'утра'
    elif x >= 12 and x <18:
        return 'дня'
    elif x >=18 and x<24:
        return 'вечера' 
